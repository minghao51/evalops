# evalops: commit per-env lock files and the git-plugin store; everything else is generated
.evalops/*
!.evalops/locks/
!.evalops/store/

# local environment files (template: .env.example) — never commit real credentials
.env
.env.*
!.env.example
*.egg-info/
__pycache__/
*.py[cod]
.venv/

# dev tooling caches (never commit; never used as evidence)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.whl
