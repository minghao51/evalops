// generated by 'make ci-adapters' from src/evalops/ci_adapters.py — edit the template, not this file
// Copy to a Jenkins "Pipeline script from SCM" job (Script Path: ci/Jenkinsfile). The Git SCM
// plugin's default clone is full (shallow: false) -- the same full history fetch-depth: 0 asks
// for elsewhere, and what the pipeline needs to diff a baseline commit.
// EVALOPS_ALLOW_FROZEN_CHANGE is not derived here: Jenkins exposes no change-request labels without a
// plugin -- set the documented boolean build parameter when `approve-dataset-change` applies.
pipeline {
  agent any

  triggers { cron('0 3 * * *') }

  parameters {
    string(name: 'EVIDENCE_GROUP', defaultValue: '', description: 'main-stage group id to promote')
    booleanParam(name: 'EVALOPS_ALLOW_FROZEN_CHANGE', defaultValue: false,
      description: 'set when `approve-dataset-change` is approved for this build')
  }

  environment {
    EVALOPS_ENV = 'local'
    PIP_EXTRAS = ''
    EVALOPS_ALLOW_FROZEN_CHANGE = "${params.EVALOPS_ALLOW_FROZEN_CHANGE}"
  }

  stages {
    // pr stage, fired by changeRequest.
    // EVALOPS_PR routes the state commit to the bot branch `evalops/state/pr-<N>` (WP2.2), so a
    // pull request from a fork publishes its locks without pushing to the source branch; the
    // pipeline picks the bot branch itself, so no fork conditional is rendered here.
    stage('pr') {
      when { changeRequest() }
      steps {
        sh 'pip install -e ".[${PIP_EXTRAS}]" -r requirements.txt'
        withEnv(["EVALOPS_PR=${env.CHANGE_ID}", "EVALOPS_BRANCH=${env.CHANGE_BRANCH}"]) {
          sh 'bash ci/pipeline.sh pr'
        }
      }
      post { always { archiveArtifacts artifacts: '.evalops/out/**', allowEmptyArchive: true } }
    }
    // main stage, fired by push to the default branch.
    stage('main') {
      when { allOf { branch 'main'; not { triggeredBy 'TimerTrigger' }; not { expression { return params.EVIDENCE_GROUP?.trim() != '' } } } }
      steps {
        sh 'pip install -e ".[${PIP_EXTRAS}]" -r requirements.txt'
        withEnv(["EVALOPS_BRANCH=main"]) {
          sh 'bash ci/pipeline.sh main'
        }
      }
      post { always { archiveArtifacts artifacts: '.evalops/out/**', allowEmptyArchive: true } }
    }
    // release stage, fired by EVIDENCE_GROUP parameter.
    stage('release') {
      when { allOf { not { triggeredBy 'TimerTrigger' }; expression { return params.EVIDENCE_GROUP?.trim() != '' } } }
      steps {
        sh 'pip install -e ".[${PIP_EXTRAS}]" -r requirements.txt'
        withEnv(["EVALOPS_BRANCH=main", "EVIDENCE_GROUP=${params.EVIDENCE_GROUP}"]) {
          sh 'bash ci/pipeline.sh release'
        }
      }
    }
    // nightly stage, fired by TimerTrigger.
    stage('nightly') {
      when { triggeredBy 'TimerTrigger' }
      steps {
        sh 'pip install -e ".[${PIP_EXTRAS}]" -r requirements.txt'
        sh 'bash ci/pipeline.sh nightly'
      }
      post { always { archiveArtifacts artifacts: '.evalops/out/**', allowEmptyArchive: true } }
    }
  }
}
