      "title": "LimitsConfig",
      "type": "object"
    },
    "MetricRule": {
      "additionalProperties": false,
      "description": "A gate rule for one metric. Six keys now; ``min_ci_lower`` is the normal-approximation lower\nbound, ``min_ci_lower_bootstrap`` the deterministic bootstrap-percentile lower bound. Anything\nelse is a typo.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "max_drop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Drop"
        },
        "max_increase_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Increase Pct"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "min_ci_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Ci Lower"
        },
        "min_ci_lower_bootstrap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Ci Lower Bootstrap"
        }
      },
      "title": "MetricRule",
      "type": "object"
    },
    "PathsConfig": {
      "additionalProperties": false,
      "properties": {
        "cassettes": {
          "default": "cassettes",
          "title": "Cassettes",
          "type": "string"
        },
        "datasets": {
          "default": "datasets",
          "title": "Datasets",
          "type": "string"
        },
        "locks": {
          "default": ".evalops",
          "title": "Locks",
          "type": "string"
        },
        "prompts": {
          "default": "prompts",
          "title": "Prompts",
          "type": "string"
        }
      },
      "title": "PathsConfig",
      "type": "object"
    },
    "PluginsConfig": {
      "additionalProperties": false,
      "description": "``plugins.<role>``: the role names are the closed set ``ports.ROLES``.\n\nA role the registry cannot serve used to reach ``Config`` as an unstructured\n\"unknown plugin roles\" error; as a model it is a dotted-path validation issue like any other\n(``plugins.promps``, ``environments.<env>.plugins.promps``).",
      "properties": {
        "datasets": {
          "title": "Datasets",
          "type": "string"
        },
        "evaluator": {
          "title": "Evaluator",
          "type": "string"
        },
        "ledger": {
          "title": "Ledger",
          "type": "string"
        },
        "prompts": {
          "title": "Prompts",
          "type": "string"
        },
        "tracer": {
          "title": "Tracer",
          "type": "string"
        }
      },
      "title": "PluginsConfig",
      "type": "object"
    },
    "PricesPerMillionTokens": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "$ref": "#/$defs/TokenPrice"
        },
        "judge": {
          "$ref": "#/$defs/TokenPrice"
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/TokenPrice"
          },
          "title": "Models",
          "type": "object"
        }
      },
      "title": "PricesPerMillionTokens",
      "type": "object"
    },
    "RedactConfig": {
      "additionalProperties": false,
      "description": "`redact:` -- the payload redaction hook (CONTRACT \u00a75.1).\n\n`mode: off` (the default) writes every byte exactly as evalops did before redaction existed;\n`strict` redacts and then re-scans, refusing to persist a payload that still matches a rule\n(exit 5). `EVALOPS_REDACT` overrides `mode` at run time. The glob syntax, the rule order and the\nidempotence contract live in `evalops.contract.redact`.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "hash": {
          "items": {
            "type": "string"
          },
          "title": "Hash",
          "type": "array"
        },
        "hook": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hook"
        },
        "mode": {
          "default": "off",
          "enum": [
            "strict",
            "off"
          ],
          "title": "Mode",
          "type": "string"
        },
        "patterns": {
          "items": {
            "$ref": "#/$defs/RedactPattern"
          },
          "title": "Patterns",
          "type": "array"
        }
      },
      "title": "RedactConfig",
      "type": "object"
    },
    "RedactPattern": {
      "additionalProperties": false,
      "description": "One `redact.patterns` rule: `regex` is substituted on every string leaf with `replace`.\n\nThe regex is compiled at validation time, so an invalid one is exit 2 naming the pattern\ninstead of a crash on the first payload.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "regex": {
          "title": "Regex",
          "type": "string"
        },
        "replace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replace"
        }
      },
      "required": [
        "name",
        "regex"
      ],
      "title": "RedactPattern",
      "type": "object"
    },
    "ReliabilityRule": {
      "additionalProperties": false,
      "description": "pass^k rules: the point estimate (``min_pass_hat_k`` / ``max_drop_pass_hat_k``) and the\nWilson lower bound of ``pass_hat_k`` (``min_pass_hat_k_wilson``).",
      "properties": {
        "max_drop_pass_hat_k": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Drop Pass Hat K"
        },
        "min_pass_hat_k": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Pass Hat K"
        },
        "min_pass_hat_k_wilson": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Pass Hat K Wilson"
        },
        "success": {
          "items": {
            "$ref": "#/$defs/ReliabilitySuccess"
          },
          "title": "Success",
          "type": "array"
        }
      },
      "title": "ReliabilityRule",
      "type": "object"
    },
    "ReliabilitySuccess": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "min": {
          "default": 1.0,
          "title": "Min",
          "type": "number"
        }
      },
      "required": [
        "metric"
      ],
      "title": "ReliabilitySuccess",
      "type": "object"
    },
    "RowLimits": {
      "additionalProperties": false,
      "description": "The per-row circuit breaker: exactly the keys the runtime consumes.\n\n``traces/capture.py`` reads ``max_steps`` / ``max_tokens`` / ``max_seconds`` literally and\n``plugins/core.py`` uses ``max_seconds`` as the async timeout, so ``max_step`` (a typo) used to\nbe accepted and silently disabled the limit. Adding a limit means adding a field here and in\nthe runtime (CONTRACT \u00a71.1).",
      "properties": {
        "max_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "max_steps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "RowLimits",
      "type": "object"
    },
    "SamplingRule": {
      "additionalProperties": false,
      "description": "``judges.<name>.sampling``: how the judge is called (reproducible defaults).\n\nRanges (``temperature`` in ``[0, 2]``, positive ``max_tokens``, integer ``seed``) are checked by\n``evalops.judges.JudgeSpec.validate()``; the key set and the types are checked here.",
      "properties": {
        "max_tokens": {
          "default": 512,
          "title": "Max Tokens",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "default": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "SamplingRule",
      "type": "object"
    },
    "ScaleRule": {
      "additionalProperties": false,
      "description": "``judges.<name>.scale``: the score range a judge emits.\n\nThe *semantic* checks (``kind`` is one of ``binary|ordinal|continuous``, ``min < max``,\n``binary`` is exactly ``0..1``) live in ``evalops.judges.JudgeSpec.validate()``, which is also\nwhat ``evalops judges`` and ``plan``/``eval``/``calibrate`` run: this model only pins the key set\nand the scalar types, so an unknown nested key is a dotted-path exit 2 (CONTRACT \u00a71.1).",
      "properties": {
        "kind": {
          "default": "binary",
          "title": "Kind",
          "type": "string"
        },
        "max": {
          "default": 1.0,
          "title": "Max",
          "type": "number"
        },
        "min": {
          "default": 0.0,
          "title": "Min",
          "type": "number"
        }
      },
      "title": "ScaleRule",
      "type": "object"
    },
    "TokenPrice": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "default": 0.0,
