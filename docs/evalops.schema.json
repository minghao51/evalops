    "JudgeRule": {
      "additionalProperties": false,
      "description": "Calibration thresholds for one judge, plus the pin ``judges.<name>.model`` of CONTRACT \u00a76.\n\n``max_mae`` is checked by ``calibrate`` (``mae <= max_mae``) for scalar/ordinal judges; it is\npart of the calibration contract, so it must be a field here (see ``calibrate``'s docstring).\nEvery threshold is *optional*: an omitted key and an explicit ``null`` both mean \"no such gate\",\nand ``calibrate`` emits no check for it instead of comparing a number to nothing.\n\nA rule **declares a judge spec** iff it carries at least one of ``rubric`` / ``scale`` /\n``prompt_version`` / ``sampling`` (``evalops.judges.SPEC_KEYS``); those four keys make it\nvalidated at load time and load-rejected when unpinned. A rule with only thresholds is the\npre-3b shape: it declares no spec and behaves exactly as before (global pin enforcement is\nWP3b.5).",
      "properties": {
        "judge": {
          "anyOf": [
            {
              "enum": [
                "native",
                "litellm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "max_mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Mae"
        },
        "min_agreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Agreement"
        },
        "min_kappa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Kappa"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "rubric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric"
        },
        "sampling": {
          "anyOf": [
            {
              "$ref": "#/$defs/SamplingRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScaleRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "title": "JudgeRule",
      "type": "object"
    },
    "LimitsConfig": {
      "additionalProperties": false,
      "properties": {
        "max_dataset_rows": {
          "anyOf": [
            {
              "type": "integer"
