        "PluginsConfig": {
          "additionalProperties": false,
          "description": "``plugins.<role>``: the role names are the closed set ``ports.ROLES``.\n\nA role the registry cannot serve used to reach ``Config`` as an unstructured\n\"unknown plugin roles\" error; as a model it is a dotted-path validation issue like any other\n(``plugins.promps``, ``environments.<env>.plugins.promps``).",
          "properties": {
            "prompts": {
              "title": "Prompts",
              "type": "string"
            },
            "datasets": {
              "title": "Datasets",
              "type": "string"
            },
            "ledger": {
              "title": "Ledger",
              "type": "string"
            },
            "tracer": {
              "title": "Tracer",
              "type": "string"
            },
            "evaluator": {
              "title": "Evaluator",
              "type": "string"
            }
          },
          "title": "PluginsConfig",
          "type": "object"
        },
        "PricesPerMillionTokens": {
          "additionalProperties": false,
          "properties": {
            "generation": {
              "$ref": "#/$defs/TokenPrice"
