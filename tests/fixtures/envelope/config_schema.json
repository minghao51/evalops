                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Drop Pass Hat K"
            }
          },
          "title": "ReliabilityRule",
          "type": "object"
        },
        "ReliabilitySuccess": {
          "additionalProperties": false,
          "properties": {
            "metric": {
              "title": "Metric",
              "type": "string"
            },
            "min": {
              "default": 1.0,
              "title": "Min",
              "type": "number"
            }
          },
          "required": [
            "metric"
          ],
          "title": "ReliabilitySuccess",
          "type": "object"
        },
        "RowLimits": {
          "additionalProperties": false,
          "description": "The per-row circuit breaker: exactly the keys the runtime consumes.\n\n``traces/capture.py`` reads ``max_steps`` / ``max_tokens`` / ``max_seconds`` literally and\n``plugins/core.py`` uses ``max_seconds`` as the async timeout, so ``max_step`` (a typo) used to\nbe accepted and silently disabled the limit. Adding a limit means adding a field here and in\nthe runtime (CONTRACT \u00a71.1).",
          "properties": {
            "max_steps": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Steps"
            },
            "max_tokens": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Tokens"
            },
            "max_seconds": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Seconds"
            }
          },
          "title": "RowLimits",
          "type": "object"
        },
        "TokenPrice": {
