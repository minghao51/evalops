        "JudgeRule": {
          "additionalProperties": false,
          "description": "Calibration thresholds for one judge, plus the pin ``judges.<name>.model`` of CONTRACT \u00a76.\n\n``max_mae`` is checked by ``calibrate`` (``mae <= max_mae``) for scalar/ordinal judges; it is\npart of the calibration contract, so it must be a field here (see ``calibrate``'s docstring).\nEvery threshold is *optional*: an omitted key and an explicit ``null`` both mean \"no such gate\",\nand ``calibrate`` emits no check for it instead of comparing a number to nothing.",
          "properties": {
            "min_agreement": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Min Agreement"
            },
            "min_kappa": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Min Kappa"
            },
            "max_mae": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Mae"
            },
            "label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Label"
            },
            "threshold": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Threshold"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Model"
            }
          },
          "title": "JudgeRule",
          "type": "object"
        },
