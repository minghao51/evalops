# evalops environment template — copy to `.env` and load it with your tool of choice
# (direnv, `set -a; . ./.env; set +a`, docker-compose `env_file`, or CI secrets).
#
# evalops reads the PROCESS environment only; it never loads `.env` itself, and `.env`
# is gitignored. Never commit real credentials.
#
# Config interpolation: evalops.yaml expands `${VAR}` / `${VAR:-default}` from this
# environment before validation, so backend endpoints and credentials belong here —
# not in the committed yaml. Redaction covers run payloads, not configuration:
# keep secrets out of `evalops.yaml` and `behavior_config()` payloads entirely.

# ── Core ──────────────────────────────────────────────────────────────────────
# Environment key from `environments:` in evalops.yaml. `local` needs no external
# services; the vendor presets (mlflow, databricks, langfuse, langsmith, logfire)
# need their SDK extra installed and their endpoint configured.
EVALOPS_ENV=local

# Who is acting — recorded in ledger tags for every run and sync.
# Convention: agent:<name> or user:<name>.
EVALOPS_ACTOR=agent:myagent

# Alternative config file (default: evalops.yaml found from the cwd upward).
#EVALOPS_CONFIG=/path/to/evalops.yaml

# ── Ledger (sql plugin) ───────────────────────────────────────────────────────
# Any SQLAlchemy URL. sqlite needs no extra install; other dialects need `evalops[sql]`.
# The shipped evalops.yaml resolves its ledger URL as:
#   url: "${EVALOPS_LEDGER_URL:-sqlite:///.evalops/ledger.sqlite}"
# Use a shared database in CI: ephemeral runners lose local SQLite files.
#EVALOPS_LEDGER_URL=postgresql+psycopg://evalops:CHANGE_ME@localhost:5433/evalops

# ── Safety overrides ──────────────────────────────────────────────────────────
# Overrides `redact.mode` in evalops.yaml at run time: `strict` | `off`.
# Any other value is a usage error (exit 2).
#EVALOPS_REDACT=strict

# ── CI (ci/pipeline.sh pr|main|release|nightly) ──────────────────────────────
#EVALOPS_PR=1234                    # tag prompt/dataset syncs with the PR number
#EVALOPS_BRANCH=evalops-bot/locks   # pr stage: branch to push .evalops/locks + store to
#EVALOPS_ALLOW_FROZEN_CHANGE=true   # ONLY via an approved review label; unfreezes
                                    # golden_regression/judge_calibration datasets
#EVALOPS_PUSH_TOKEN=                # CI bot token; the GitLab adapter embeds it in the push URL
#EVIDENCE_GROUP=main-2026-10-24     # release stage: evidence group that passed the gate

# ── Vendor credentials (phase 3 verification; presets interpolate these) ─────────
# Each vendor SDK reads its own credentials from the process environment; the presets
# reference them via `${VAR:-default}` interpolation, never as literals. Uncomment and
# fill only what your preset needs; everything here is optional for `local`.
#
# Logfire (preset `logfire`/`mixed`, tracer role):
#   LOGFIRE_TOKEN is the SDK's write token — `logfire.configure(send_to_logfire=
#   "if-token-present")` sends spans only when it is set. LOGFIRE_READ_TOKEN enables
#   evalops' token-usage lookup via the Logfire Query API (the plugin's `read_token`).
#LOGFIRE_TOKEN=
#LOGFIRE_READ_TOKEN=
#LOGFIRE_SERVICE_NAME=evalops
#
# Langfuse (preset `langfuse`): keys from the Langfuse project settings.
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or LANGFUSE_HOST for self-hosted
#
# LangSmith (preset `langsmith`).
#LANGSMITH_API_KEY=
#LANGSMITH_ENDPOINT=                            # self-hosted only
#
# MLflow (preset `mlflow`): a tracking server or a local `mlflow server`.
#MLFLOW_TRACKING_URI=http://localhost:5000
#MLFLOW_EXPERIMENT=evalops
#
# Databricks (preset `databricks`): workspace credentials for the MLflow plugin.
#DATABRICKS_HOST=https://adb-xxxxx.xx.azuredatabricks.net
#DATABRICKS_TOKEN=
#DATABRICKS_TRACKING_URI=databricks
#DATABRICKS_REGISTRY_URI=databricks-uc
#DATABRICKS_EXPERIMENT=/Shared/evalops
#DATABRICKS_NAMESPACE=ml.genai_eval

# ── Repo development / tests ─────────────────────────────────────────────────
# Postgres contract suite (tests/contract/, run via `make contract`): an SQLAlchemy URL
# for an already-running database. Unset = `tests/contract/docker-compose.yml`; the suite
# skips cleanly when neither docker nor this URL is available.
#EVALOPS_TEST_POSTGRES_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5433/evalops

# Regenerate the frozen --json envelope goldens after an additive `data` change
# (tests/unit/test_envelope.py). Never hand-edit tests/fixtures/envelope/*.json.
#EVALOPS_UPDATE_GOLDENS=1
